              "raw": "{\n  \"userId\": \"user-001\",\n  \"client_name\": \"의뢰인\",\n  \"provider_name\": \"용역자\",\n  \"contract_date\": \"2026-07-19\",\n  \"client_business_number\": \"123-45-67890\",\n  \"client_contact\": \"010-1234-5678\",\n  \"provider_business_number\": \"987-65-43210\",\n  \"provider_contact\": \"010-8765-4321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/session/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session",
                "connect"
              ]
            },
            "description": "Create a session and receive a sid. userId is required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Archive",
      "item": [
        {
          "name": "GET Session List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
