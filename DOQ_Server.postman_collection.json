  },
  "item": [
    {
      "name": "Basic",
      "item": [
        {
          "name": "GET Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/basic/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "basic",
                "ping"
              ]
            },
            "description": "Health check endpoint. Returns status, message, and tid."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "POST Connect Session",
          "request": {
